<section class="card event-list" aria-labelledby="event-list-heading" data-testid="event-list">
  <h2 id="event-list-heading">All events</h2>
  <% events.group_by { |event| event.happened_on.year }.each do |year, year_events| %>
    <div class="event-list__group" data-timeline-target="group">
      <h3 class="event-list__year"><%= year %></h3>
      <ol class="events">
        <% year_events.each do |event| %>
          <li id="<%= dom_id(event) %>" class="event-list__item <%= category_class(event.category) %>"
            data-timeline-target="row" data-category="<%= event.category %>" data-testid="event-list-item" data-event-id="<%= event.id %>">
            <time datetime="<%= event.happened_on.iso8601 %>"><%= event.happened_on.strftime("%b %-d") %></time>
            <%= link_to event.title, event, class: "event-list__title",
              data: { turbo_frame: "event_details", action: "timeline#select", timeline_id_param: event.id } %>
            <%= category_chip(event.category) %>
          </li>
        <% end %>
      </ol>
    </div>
  <% end %>
</section>
